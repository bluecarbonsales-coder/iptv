# Simple source-manager login (used at /admin.html; defaults also work without these lines)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=0809

# The /admin.html source manager uses ADMIN_USERNAME and ADMIN_PASSWORD above; it needs no API token.
# These optional tokens are only for refresh / agent / integration features.
REFRESH_TOKEN=replace-with-a-long-random-refresh-token
SOURCE_TOKEN=replace-with-a-different-long-random-source-token
AGENT_API_TOKEN=replace-with-a-third-long-random-agent-token

# Enables agent editing of any tracked repository file, branches, PRs, CI and workflows.
# Use a fine-scoped GitHub App token or PAT with Contents, Pull requests, and Actions write access.
# Store the real value only in the deployment environment/secret manager; never commit it.
GITHUB_REPO_TOKEN=replace-with-a-github-repository-token
GITHUB_REPOSITORY=bluecarbonsales-coder/iptv
GITHUB_DEFAULT_BRANCH=main

# full: trusted authenticated agent can modify providers unattended.
# review: background-discovered providers are left disabled until reviewed.
# off: scheduled registry discovery is disabled.
AGENT_AUTONOMY=full
AGENT_AUTOMATION_ENABLED=1
AUTO_SOURCE_SYNC_HOURS=12

# Default maintained registry: TVboxorg publishes an automatically probed official.json list.
# The importer only accepts/probes compatible Apple CMS/MacCMS endpoints from it; this does not verify content rights.
# Override with your own comma/newline-separated JSON config URLs (LibreTV sources[], MoonTV api_site{}, TVBox sites[]).
VOD_SOURCE_LIST_URLS=https://raw.githubusercontent.com/TVboxorg/TVbox/main/dist/official.json

# Capacity for enabled/configured provider endpoints. Raise if you maintain a larger catalog.
MAX_VOD_SOURCES=128
MAX_SOURCES=64

# Movie metadata APIs — DEVELOPMENT/TEST ONLY.
# These sample keys are intentionally published at the repository owner's request.
# Do not reuse this configuration for production. Public keys can be copied and quota-abused.
# TMDB v3 API key: https://developer.themoviedb.org/
TMDB_API_KEY=521e53596957b410b3e69b5eefb5cb00
# OMDb API key: https://www.omdbapi.com/
OMDB_API_KEY=dfa677fa

# TVmaze public metadata endpoints do not require an API key.
# Do not put the separately supplied TVmaze account key in this public example file.
# If you later use TVmaze Premium user endpoints, store credentials in deployment secrets.

# Mail Workspace: use actual server-side secrets; never commit real values.
EMAIL_WORKSPACE_PASSWORD=
EMAIL_SESSION_SECRET=
EMAIL_CREDENTIALS_KEY=
EMAIL_ALLOWED_MAIL_HOSTS=mail.nafisainternational.com
MAIL_COOKIE_SECURE=1
# approval is default; direct permits trusted agents to send without owner approval.
EMAIL_AGENT_SEND_MODE=approval
