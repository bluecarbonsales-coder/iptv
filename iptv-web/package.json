{
  "name": "iptv-web",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted IPTV portal with secure IMAP/SMTP Mail Workspace",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node tools/setup-local.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "imapflow": "2.5.4",
    "mailparser": "3.11.0",
    "nodemailer": "10.2.1"
  }
}
